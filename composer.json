{
	"name": "octfx/template-styles-extender",
	"type": "mediawiki-extension",
	"description": "Extends TemplateStyles with new CSS properties",
	"keywords": [
		"MediaWiki",
		"TemplateStyles",
		"TemplateStylesExtender",
		"extension"
	],
	"homepage": "https://www.mediawiki.org/wiki/Extension:TemplateStylesExtender",
	"readme": "README.md",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Hannes Kruse",
			"homepage": "https://octofox.de/",
			"role": "Developer"
		},
		{
			"name": "alistair3149",
			"role": "Developer"
		}
	],
	"support": {
		"wiki": "https://www.mediawiki.org/wiki/Extension:TemplateStylesExtender",
		"forum": "https://www.mediawiki.org/wiki/Extension_talk:TemplateStylesExtender",
		"issues": "https://github.com/octfx/mediawiki-extensions-TemplateStylesExtender/issues",
		"source": "https://github.com/octfx/mediawiki-extensions-TemplateStylesExtender"
	},
	"require": {
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.0",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"parallel-lint . --exclude node_modules --exclude vendor",
			"@phpcs",
			"minus-x check ."
		],
		"phan": "phan -d . --long-progress-bar",
		"phpcs": [
			"phpcs --config-set ignore_warnings_on_exit 1",
			"phpcs -sp --cache"
		],
		"phpunit": "cd ../../ && composer phpunit -- extensions/TemplateStylesExtender/tests/phpunit/",
		"preflight": [
			"@test",
			"@phan",
			"@phpunit"
		]
	},
	"extra": {
		"installer-name": "TemplateStylesExtender"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
